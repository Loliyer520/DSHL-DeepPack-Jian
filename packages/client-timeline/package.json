{
  "name": "@djian/client-ui-timeline",
  "version": "0.1.0",
  "private": true,
  "description": "D剪剪辑面板：官方 dsh web 壳里的右侧栏 tab（预览/片段/字幕/导出）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  }
}
