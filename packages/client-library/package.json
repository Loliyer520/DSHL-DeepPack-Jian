{
  "name": "@djian/client-ui-library",
  "version": "0.1.0",
  "private": true,
  "description": "D剪资源库面板：官方 dsh web 壳右侧栏 tab（在线 CC 素材搜索/试听/导入）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/client.js"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "devDependencies": {
    "tsdown": "^0.23.0"
  }
}
