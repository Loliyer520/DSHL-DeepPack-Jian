{
  "manifestVersion": 5,
  "type": "profile",
  "name": "djian",
  "version": "3.1.0",
  "displayName": {
    "zh-CN": "D剪 · AI 视频剪辑工作台",
    "en-US": "Djian · AI Video Editing Workbench"
  },
  "description": {
    "zh-CN": "人与 AI 协同制作视频：原生图文与动画、轻量 3D 和高级转场、设计保护与实测审片、交付质量检查、按任务提供上下文和批量修改预演。",
    "en-US": "Collaborative AI video editing with native visual elements, lightweight 3D and transitions, protected design choices, measured review, delivery checks, task-scoped context and edit rehearsal."
  },
  "author": "Loliy",
  "profileName": "djian",
  "dshVersion": "0.2.0-rc.2",
  "dshVersions": [
    "0.2.0-rc.2"
  ],
  "launchers": {
    "dshl": {
      "supported": true,
      "minVersion": "0.5.0.0",
      "reason": "使用 DSHL 的 vendor 直挂安装与 services 本地服务托管"
    },
    "hdsl": {
      "supported": false,
      "reason": "依赖 DSHL 扩展（vendor 直挂、services）"
    },
    "dsh-packforge-app": {
      "supported": false,
      "reason": "依赖 DSHL 扩展（vendor 直挂、services）"
    },
    "official-desktop": {
      "supported": false,
      "reason": "依赖 DSHL 扩展（vendor 直挂、services）"
    },
    "dsh-cli": {
      "supported": false,
      "reason": "依赖 DSHL 扩展（vendor 直挂、services）"
    }
  },
  "bundles": [
    "@deepseek-ai/dsh-base",
    "@deepseek-ai/dsh-web-app"
  ],
  "dependencies": {
    "@djian/engine": "vendor:djian-engine-0.3.0.tgz",
    "@djian/webui": "vendor:djian-webui-0.3.0.tgz",
    "@djian/host-bridge": "vendor:djian-host-bridge-0.3.0.tgz",
    "@djian/client-ui-timeline": "vendor:djian-client-ui-timeline-0.3.0.tgz",
    "@djian/client-ui-library": "vendor:djian-client-ui-library-0.3.0.tgz",
    "@remotion/renderer": "4.0.526",
    "remotion": "4.0.526",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.76"
  },
  "services": [
    {
      "name": "djian-engine",
      "command": "node",
      "args": [
        "./node_modules/@djian/webui/server/index.mjs"
      ],
      "env": {
        "NODE_USE_ENV_PROXY": "1"
      },
      "port": 5180,
      "portAutoBump": true,
      "healthPath": "/api/health",
      "readyTimeoutMs": 90000,
      "required": true
    }
  ]
}
