{
  "name": "djian",
  "version": "0.2.0",
  "private": true,
  "description": "D剪 — JSON 时间线驱动的 AI+人协同视频剪辑：引擎、剪辑面板、宿主桥接插件与 dsh 整合包",
  "scripts": {
    "build:engine": "tsc -p packages/engine/tsconfig.build.json && node packages/engine/scripts/build-mathjax.mjs",
    "build:client": "npm run bundle:timeline && npm run bundle:library",
    "bundle:timeline": "tsdown -c packages/client-timeline/tsdown.config.ts",
    "bundle:library": "tsdown -c packages/client-library/tsdown.config.ts",
    "check": "tsc -p packages/engine/tsconfig.json --noEmit && tsc -p packages/client-timeline/tsconfig.json --noEmit && tsc -p packages/client-library/tsconfig.json --noEmit",
    "test": "npm run build:engine && node --test tests/*.test.mjs",
    "test:render": "npm run build:engine && node tests/integration/render-smoke.mjs",
    "test:spatial": "npm run build:engine && node tests/integration/spatial-transitions.mjs",
    "test:effects": "npm run build:engine && node tests/integration/element-effects.mjs",
    "test:seek": "npm run build:engine && node tests/integration/media-seek.mjs",
    "start:engine": "npm run build:engine && node packages/webui/server/index.mjs",
    "pack": "node packages/pack/scripts/build-dspack.mjs",
    "test:host": "npm run build:engine && node tests/integration/dsh-host.mjs",
    "serve:dsh": "npm run build:engine && node tests/integration/dsh-serve.mjs",
    "pack:check": "node packages/pack/scripts/build-dspack.mjs --check-only",
    "test:motion": "npm run build:engine && node tests/integration/motion-effects.mjs",
    "test:choreography": "npm run build:engine && node tests/integration/choreography.mjs",
    "test:polish": "npm run build:engine && node tests/integration/polish.mjs",
    "test:surface": "npm run build:engine && node tests/integration/surface.mjs",
    "test:layout-blur": "npm run build:engine && node tests/integration/layout-blur.mjs",
    "test:ambient": "npm run build:engine && node tests/integration/ambient.mjs",
    "test:studio": "npm run build:engine && node tests/integration/studio.mjs",
    "test:studio-ui": "npm run build:engine && node tests/integration/studio-ui.mjs",
    "test:workflow": "npm run build:engine && node tests/integration/project-workflow.mjs",
    "test:project-ui": "npm run build:engine && node tests/integration/project-tools-ui.mjs",
    "test:visual": "npm run build:engine && node tests/integration/visual-regression.mjs",
    "visual:update": "npm run build:engine && node tests/integration/visual-regression.mjs --update",
    "test:adaptive-ui": "npm run build:engine && node tests/integration/adaptive-design-ui.mjs",
    "test:review": "npm run build:engine && node tests/integration/review-workflow.mjs",
    "test:review-ui": "npm run build:engine && node tests/integration/review-ui.mjs",
    "test:delivery": "npm run build:engine && node tests/integration/delivery-workflow.mjs",
    "test:delivery-ui": "npm run build:engine && node tests/integration/delivery-ui.mjs",
    "test:ai-workflow": "npm run build:engine && node tests/integration/ai-workflow.mjs",
    "test:ai-ui": "npm run build:engine && node tests/integration/ai-workflow-ui.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "5.6.3",
    "tsdown": "^0.23.0",
    "remotion": "4.0.526",
    "@remotion/player": "4.0.526",
    "@remotion/bundler": "4.0.526",
    "@remotion/renderer": "4.0.526",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.76",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/node": "^22.10.0",
    "mathjax-full": "3.2.2"
  },
  "engines": {
    "node": ">=22.18"
  },
  "type": "module"
}
